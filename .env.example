# Paths used by the API to load persisted canonical state and source metadata.
# These defaults match the Docker Compose volume/application layout.
BUI_RUNTIME_STATE=/app/data/runtime/state.json
BUI_REFERENCE_STATE=/app/data/runtime/reference.json
BUI_ENERGY_STATE=/app/data/runtime/energy.json
BUI_DERIVED_STATE=/app/data/runtime/derived.json
BUI_SOURCE_REGISTRY=/app/config/sources.yaml

# Current configured provider sources are public. Never commit real secrets here.
